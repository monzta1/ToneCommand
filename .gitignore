# virtualenv and caches
.venv/
__pycache__/
*.pyc
.DS_Store

# secrets
.env

# personal working notes (agent knowledge base) - not part of the release
kb/

# local --with-prose build of the amp sidecar: carries the source guide's own
# notes and tips, which are its author's writing and are not redistributed.
config/amp_models.full.json

# local --with-prose build of the cab sidecar: keeps the wiki's descriptions
# verbatim instead of reducing them to the cabinet's identity.
config/cab_models.full.json

# never commit preset/backup payloads (personal presets, Fractal-Bot
# backups, Gift of Tone content)
*.syx
*.blk
*.fasBundle
backups/
tonecommand.egg-info/

# the AI backend choice, which holds an API key
ai_settings.json
store_slots.json
designs/
outbox.json

# wrangler caches the Cloudflare account id and name here. Not a credential,
# but it is account metadata and a build artefact, and neither belongs in git.
.wrangler/
